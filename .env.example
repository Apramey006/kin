NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set either provider key. Auto prefers Anthropic when its key is present.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional alternative provider
OPENAI_API_KEY=
# OpenAI model for photo descriptions and memory extraction
OPENAI_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Choose a calm, warm voice
ELEVENLABS_VOICE_ID=
# Legacy seed CLI only. App requests use the signed-in family membership.
NEXT_PUBLIC_KIN_FAMILY_ID=demo
